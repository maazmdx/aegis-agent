# Aegis environment variables.
# Copy to .env (`cp .env.example .env`), fill in real values, then `source .env`.
# NEVER commit a real .env with secrets.

# --- Required -------------------------------------------------------------
# Google Cloud project that hosts Firestore + Pub/Sub.
export PROJECT_ID="aegis-hackathon-506413"

# Gemini API key from Google AI Studio (used by the diagnoser).
export GEMINI_API_KEY="your-ai-studio-key"

# The ADK reads GOOGLE_API_KEY; keep it in sync with GEMINI_API_KEY.
export GOOGLE_API_KEY="$GEMINI_API_KEY"

# --- Optional ------------------------------------------------------------
# Region for Cloud Run / GCP resources.
export LOCATION="us-central1"

# Gemini model id used for diagnosis.
export MODEL="gemini-3.1-flash-lite"

# "true" (default) auto-approves gated actions for the fully-autonomous demo.
# Set to "false" to enforce the human-in-the-loop governance gate.
export AEGIS_AUTO_APPROVE="true"

# Optional Slack incoming webhook for postmortem notifications.
export SLACK_WEBHOOK_URL=""
export AEGIS_AUTO_PIPELINE="false"  # Set to "true" to have the detector auto-triage instead of the agent
