# Aegis environment configuration (example)
# Copy to .env and run: source .env   (never commit your real .env)
#
# Aegis uses Vertex AI with Application Default Credentials (ADC).
# - On Cloud Run: the service account supplies credentials automatically.
# - Locally: run  gcloud auth application-default login
# No API key is required.

# Google Cloud project ID
export PROJECT_ID="your-gcp-project"

# Vertex AI location for Gemini (use "global" unless a specific region is required)
export GOOGLE_CLOUD_LOCATION="global"

# Cloud Run region for the deployed services
export REGION="us-east1"

# Gemini model (served via Vertex AI)
export MODEL="gemini-3.5-flash-lite"

# Governance gate:
#   "true"  -> auto-approve gated actions (fully autonomous demo)
#   "false" -> require human approval for high-impact actions
export AEGIS_AUTO_APPROVE="true"
